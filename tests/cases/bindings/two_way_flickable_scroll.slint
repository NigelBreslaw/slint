instance.window.dispatchEvent({ type: "pointer-scrolled", position: { x: 50, y: 50 }, deltaX: 0, deltaY: -50 });
slintlib.private_api.mock_elapsed_time(1000);
assert.equal(instance.scroll_position, -50);
assert.equal(instance.change_count, 1);
```
