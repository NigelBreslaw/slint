fn focus_loss_cancels_space_press() {
    use slint::{SharedString, platform::{Key, WindowEvent}};

    let instance = TestCase::new().unwrap();
    instance.invoke_focus_first();
    instance.window().dispatch_event(WindowEvent::KeyPressed { text: Key::Space.into() });
    assert!(instance.get_first_pressed());
    instance.invoke_focus_second();
    assert!(!instance.get_first_focused());
    assert!(!instance.get_first_pressed(), "Focus loss must cancel the pending Space press");
    instance.window().dispatch_event(WindowEvent::KeyReleased { text: Key::Space.into() });
    assert_eq!(instance.get_first_clicks(), 0);
    assert_eq!(instance.get_second_clicks(), 0);
    instance.invoke_focus_first();
    assert!(!instance.get_first_pressed());
    slint_testing::send_keyboard_string_sequence(&instance, &SharedString::from(Key::Space));
    assert_eq!(instance.get_first_clicks(), 1);
}

focus_loss_cancels_space_press();
```

```rust
fn disabling_cancels_space_press() {
    use slint::{SharedString, platform::{Key, WindowEvent}};

    let instance = TestCase::new().unwrap();
    instance.invoke_focus_first();
    instance.window().dispatch_event(WindowEvent::KeyPressed { text: Key::Space.into() });
    assert!(instance.get_first_pressed());
    instance.set_first_enabled(false);
    assert!(!instance.get_first_pressed());
    instance.window().dispatch_event(WindowEvent::KeyReleased { text: Key::Space.into() });
    assert_eq!(instance.get_first_clicks(), 0);
    instance.set_first_enabled(true);
    instance.invoke_focus_first();
    assert!(!instance.get_first_pressed());
    instance.window().dispatch_event(WindowEvent::KeyReleased { text: Key::Space.into() });
    assert_eq!(instance.get_first_clicks(), 0);
    slint_testing::send_keyboard_string_sequence(&instance, &SharedString::from(Key::Space));
    assert_eq!(instance.get_first_clicks(), 1);
}

disabling_cancels_space_press();
