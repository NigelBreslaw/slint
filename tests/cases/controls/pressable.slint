fn reenabling_before_space_release_does_not_restore_press() {
    use slint::platform::{Key, WindowEvent};

    let instance = TestCase::new().unwrap();
    instance.invoke_focus_first();
    instance.window().dispatch_event(WindowEvent::KeyPressed { text: Key::Space.into() });
    assert!(instance.get_first_pressed());
    instance.set_first_enabled(false);
    slint_testing::mock_elapsed_time(0);
    assert!(!instance.get_first_pressed());
    instance.set_first_enabled(true);
    instance.invoke_focus_first();
    assert!(!instance.get_first_pressed(), "Re-enabling must not restore a canceled press");
    instance.window().dispatch_event(WindowEvent::KeyReleased { text: Key::Space.into() });
    assert_eq!(instance.get_first_clicks(), 0, "Releasing a canceled press must not click");
}

reenabling_before_space_release_does_not_restore_press();
