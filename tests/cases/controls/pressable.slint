import { Pressable } from "../../../internal/compiler/controls/primitives/pressable.slint";

export component TestCase inherits Window {
    width: 200px;
    height: 80px;

    in-out property <bool> first-enabled: true;
    out property <int> first-clicks;
    out property <int> second-clicks;
    out property <bool> first-focused: first.has-focus;
    out property <bool> first-pressed: first.pressed;

    public function focus-first() { first.focus(); }
    public function focus-second() { second.focus(); }

    VerticalLayout {
        first := Pressable {
            enabled: root.first-enabled;
            height: 40px;
            clicked => { root.first-clicks += 1; }
        }

        second := Pressable {
            height: 40px;
            clicked => { root.second-clicks += 1; }
        }
    }
}

