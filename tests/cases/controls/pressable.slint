```rust
fn releasing_pointer_outside_cancels_click() {
    use slint::{LogicalPosition, platform::{PointerEventButton, WindowEvent}};

    let instance = TestCase::new().unwrap();
    let inside = LogicalPosition::new(100.0, 20.0);
    let outside = LogicalPosition::new(100.0, 60.0);
    instance.window().dispatch_event(WindowEvent::PointerMoved { position: inside });
    instance.window().dispatch_event(WindowEvent::PointerPressed {
        position: inside, button: PointerEventButton::Left,
    });
    assert!(instance.get_first_pressed());
    assert_eq!(instance.get_first_clicks(), 0);
    instance.window().dispatch_event(WindowEvent::PointerMoved { position: outside });
    instance.window().dispatch_event(WindowEvent::PointerReleased {
        position: outside, button: PointerEventButton::Left,
    });
    assert!(!instance.get_first_pressed());
    assert_eq!(instance.get_first_clicks(), 0);
    assert_eq!(instance.get_second_clicks(), 0);
    let first = slint_testing::ElementHandle::find_by_element_id(&instance, "TestCase::first")
        .next().unwrap();
    first.mock_single_click(PointerEventButton::Left);
    assert_eq!(instance.get_first_clicks(), 1);
}

releasing_pointer_outside_cancels_click();
```

