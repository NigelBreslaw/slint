```rust
fn inheritance_and_composition_support_activation() {
    use slint::{SharedString, platform::{Key, PointerEventButton}};

    let instance = TestCase::new().unwrap();
    let inherited = slint_testing::ElementHandle::find_by_element_id(&instance, "TestCase::inherited")
        .next().unwrap();
    let composed = slint_testing::ElementHandle::find_by_element_id(&instance, "TestCase::composed")
        .next().unwrap();

    assert_eq!(inherited.accessible_role(), Some(slint_testing::AccessibleRole::Button));
    assert_eq!(inherited.accessible_label(), Some(SharedString::from("Inherited")));
    assert_eq!(inherited.accessible_enabled(), Some(true));
    inherited.mock_single_click(PointerEventButton::Left);
    assert_eq!(instance.get_inherited_clicks(), 1);

    instance.invoke_focus_inherited();
    assert!(instance.get_inherited_focused());
    slint_testing::send_keyboard_string_sequence(&instance, &SharedString::from(Key::Space));
    slint_testing::send_keyboard_string_sequence(&instance, &SharedString::from(Key::Return));
    assert_eq!(instance.get_inherited_clicks(), 3);

    instance.set_first_enabled(false);
    assert_eq!(inherited.accessible_enabled(), Some(false));
    inherited.mock_single_click(PointerEventButton::Left);
    inherited.invoke_accessible_default_action();
    assert_eq!(instance.get_inherited_clicks(), 3);

    composed.mock_single_click(PointerEventButton::Left);
    assert_eq!(instance.get_composed_clicks(), 1);
}

inheritance_and_composition_support_activation();
```

