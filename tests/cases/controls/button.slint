import { Button } from "@controls";

component InheritedButton inherits Button {
    Rectangle {
        background: root.pressed ? blue : root.has-hover ? green : gray;
    }
}

component ComposedButton inherits Rectangle {
    in property <string> text <=> behavior.text;
    in property <bool> enabled <=> behavior.enabled;
    out property <bool> has-focus: behavior.has-focus;
    callback clicked <=> behavior.clicked;

    forward-focus: behavior;

    behavior := Button {
        Rectangle { background: root.enabled ? black : gray; }
    }
}

export component TestCase inherits Window {
    width: 200px;
    height: 80px;

    in-out property <bool> first-enabled: true;
    out property <int> inherited-clicks;
    out property <int> composed-clicks;
    out property <bool> inherited-focused: inherited.has-focus;

    out property <bool> inherited-pressed: inherited.pressed;

    public function focus-inherited() { inherited.focus(); }

    VerticalLayout {
        inherited := InheritedButton {
            text: "Inherited";
            enabled: root.first-enabled;
            height: 40px;
            clicked => { root.inherited-clicks += 1; }
        }

        composed := ComposedButton {
            text: "Composed";
            height: 40px;
            clicked => { root.composed-clicks += 1; }
        }
    }
}

